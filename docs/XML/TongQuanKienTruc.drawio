        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-1" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1e293b;" value="TỔNG THỂ KIẾN TRÚC PHÂN TẦNG ASP.NET CORE - HỆ THỐNG ATOMOS (.NET 10)" vertex="1">
          <mxGeometry height="40" width="950" x="-140" y="140" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-2" parent="1" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;dashPattern=5 5;arcSize=10;" value="HỆ THỐNG MÁY CHỦ BACKEND" vertex="1">
          <mxGeometry height="730" width="445" x="115" y="210" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-3" parent="Uf-4Hot8mkbxUUNbnSTG-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Atomos.API&lt;/b&gt;&lt;br&gt;&lt;i&gt;Tầng Trình bày &amp;amp; Cổng giao tiếp RESTful Web API&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• &lt;b&gt;Controllers:&lt;/b&gt; Auth, Sandbox, Practice, Exams, Admin, Lookup, Access&lt;br&gt;• &lt;b&gt;Middlewares:&lt;/b&gt; Session Ticket Auth, CSRF Validation, Exception Handler, Rate Limiting&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Cookie HttpOnly (__Host-Atomos.Auth) &amp;amp; X-CSRF-TOKEN&lt;br&gt;• &lt;b&gt;Startup &amp;amp; DI:&lt;/b&gt; Kestrel Web Server, Program.cs, Service Registration&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="390" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-4" parent="Uf-4Hot8mkbxUUNbnSTG-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Atomos.Application&lt;/b&gt;&lt;br&gt;&lt;i&gt;Tầng Ứng dụng &amp;amp; Điều phối ca sử dụng (Use Cases)&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• &lt;b&gt;Services:&lt;/b&gt; SandboxStoichiometryService, AuthService, PracticeService, ExamService&lt;br&gt;• &lt;b&gt;AI Proposal:&lt;/b&gt; KnowledgeProposalService (HITL Crawl &amp;amp; Phê duyệt tri thức)&lt;br&gt;• &lt;b&gt;Contracts &amp;amp; DTOs:&lt;/b&gt; Request/Response models, Abstraction Interfaces&lt;br&gt;• &lt;b&gt;Engines:&lt;/b&gt; Chemical equation balancer, Reaction candidate ranker&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="390" x="30" y="210" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-5" parent="Uf-4Hot8mkbxUUNbnSTG-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Atomos.Domain&lt;/b&gt;&lt;br&gt;&lt;i&gt;Tầng Miền nghiệp vụ cốt lõi (Core Business Domain)&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• &lt;b&gt;Entities:&lt;/b&gt; HoaChat, NguyenTo, PhuongTrinh, BaiTap, NguoiDung, DeXuatTriThucAI...&lt;br&gt;• &lt;b&gt;Value Objects &amp;amp; Enums:&lt;/b&gt; LoaiPhanUng, TrangThaiVatLy, LoaiBaiTap, VaiTroNguoiDung&lt;br&gt;• &lt;b&gt;Rules &amp;amp; Exceptions:&lt;/b&gt; Stoichiometry constraints, Domain Validation Logic&lt;br&gt;• &lt;i&gt;Hoàn toàn độc lập, không phụ thuộc vào công nghệ hay tầng bên ngoài&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="390" x="30" y="380" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-6" parent="Uf-4Hot8mkbxUUNbnSTG-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Atomos.Infrastructure&lt;/b&gt;&lt;br&gt;&lt;i&gt;Tầng Hạ tầng cơ sở &amp;amp; Hiện thực hóa truy xuất dữ liệu&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• &lt;b&gt;ORM &amp;amp; DbContext:&lt;/b&gt; AtomosDbContext (EF Core 10), Database Migrations&lt;br&gt;• &lt;b&gt;Micro-ORM:&lt;/b&gt; Dapper Repositories (DungCuRepository tối ưu đọc hiệu năng cao)&lt;br&gt;• &lt;b&gt;Security Impl:&lt;/b&gt; BCrypt Password Hasher, Session Storage&lt;br&gt;• &lt;b&gt;Background Jobs:&lt;/b&gt; KnowledgeProposalWorker (Crawler &amp;amp; Queue Worker)&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="390" x="27.5" y="585" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-7" edge="1" parent="Uf-4Hot8mkbxUUNbnSTG-2" source="Uf-4Hot8mkbxUUNbnSTG-3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#2563eb;" target="Uf-4Hot8mkbxUUNbnSTG-4" value="Invokes Use Case Services">
