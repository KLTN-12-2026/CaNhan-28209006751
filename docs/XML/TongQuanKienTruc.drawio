        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Frontend Client&lt;/b&gt;&lt;br&gt;&lt;i&gt;Giao diện người dùng SPA&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• React 19, TypeScript, Vite&lt;br&gt;• Tailwind CSS &amp;amp; Lucide Icons&lt;br&gt;• KaTeX hóa học &amp;amp; Canvas Sandbox&lt;br&gt;• Ống nghiệm mô phỏng &amp;amp; 9 công cụ&lt;br&gt;• Axios / Fetch Client&lt;br&gt;• Cookie Credentials &amp;amp; CSRF Header&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="170" x="-150" y="215" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-13" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Cơ sở dữ liệu&lt;/b&gt;&lt;br&gt;&lt;b&gt;SQL Server&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• 50 bảng chuẩn hóa (Canonical)&lt;br&gt;• 465 cột dữ liệu&lt;br&gt;• 59 Khóa ngoại (FK)&lt;br&gt;• 79 Ràng buộc CHECK&lt;br&gt;• 27 Ràng buộc UNIQUE&lt;br&gt;• 57 Chỉ mục (Indexes)&lt;br&gt;• 4 bảng Đề xuất tri thức AI&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="180" x="620" y="750" as="geometry" />
        </mxCell>
        <mxCell id="Uf-4Hot8mkbxUUNbnSTG-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;align=center;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Dịch vụ tích hợp bên ngoài&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• &lt;b&gt;Google Identity:&lt;/b&gt; OAuth 2.0 Login&lt;br&gt;• &lt;b&gt;Google Gemini 3.5 Flash:&lt;/b&gt; Socratic AI Tutor &amp;amp; Admin Text Extractor&lt;br&gt;• &lt;b&gt;Crawl Sources (Allowlist):&lt;/b&gt; PubChem, NIST WebBook, IUPAC, OpenStax&lt;br&gt;• &lt;b&gt;PayOS Gateway:&lt;/b&gt; Cổng thanh toán gói nâng cao&lt;br&gt;• &lt;b&gt;SMTP Mailer:&lt;/b&gt; Gửi mã OTP phục hồi mật khẩu&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="200" x="640" y="195" as="geometry" />
