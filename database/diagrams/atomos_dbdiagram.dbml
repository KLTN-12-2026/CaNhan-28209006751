  HienTuongTemplate nvarchar(max)
  GiaiThichTemplate nvarchar(max)
  NgayTao datetime2 [not null, default: `SYSUTCDATETIME()`]
  NgayCapNhat datetime2 [not null, default: `SYSUTCDATETIME()`]

  indexes {
    (MaQuyLuat) [unique, name: 'UQ_QuyLuatPhanUng_MaQuyLuat']
    (DangHoatDong, DoUuTien) [name: 'IX_QuyLuatPhanUng_DangHoatDong_DoUuTien']
  }

  Note: '''
  CONSTRAINT CK_QuyLuatPhanUng_DoUuTien CHECK (DoUuTien >= 0)
