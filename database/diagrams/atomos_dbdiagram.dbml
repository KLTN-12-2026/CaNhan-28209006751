Table dbo.ThuThachXuong {
  IDThuThach int [pk, increment, not null]
  TenThuThach nvarchar(150) [not null]
  MoTa nvarchar(max)
  DangHoatDong bit [not null, default: 1]
  DoKho nvarchar(30) [not null]
  NgayThuThach date
  SlotThuThach int
  Seed nvarchar(120)
  PhienBanGenerator nvarchar(40)
  MetadataJson nvarchar(max)
  NguonTao nvarchar(40) [not null, default: 'AdminLegacy']
  ThoiGianGioiHanGiay int [not null]
  IDHoaChatMucTieu int [not null]
  LuongMucTieu decimal(18,4) [not null]
  DonViMucTieu nvarchar(20) [not null]
  DiemCoBan int [not null, default: 100]
  DiemThuongSom int [not null, default: 0]
  NguongThuongSomGiay int [not null, default: 0]
  DiemPhatTre int [not null, default: 0]
  NgayTao datetime2 [not null, default: `SYSUTCDATETIME()`]
  NgayCapNhat datetime2 [not null, default: `SYSUTCDATETIME()`]

  indexes {
    (DangHoatDong, DoKho) [name: 'IX_ThuThachXuong_DangHoatDong_DoKho']
    (IDHoaChatMucTieu) [name: 'IX_ThuThachXuong_IDHoaChatMucTieu']
  }

  Note: '''
  CONSTRAINT CK_ThuThachXuong_ThoiGian CHECK (ThoiGianGioiHanGiay > 0)
  CONSTRAINT CK_ThuThachXuong_Slot CHECK (SlotThuThach IS NULL OR SlotThuThach BETWEEN 1 AND 5)
  CONSTRAINT CK_ThuThachXuong_LuongMucTieu CHECK (LuongMucTieu > 0)
  CONSTRAINT CK_ThuThachXuong_Diem CHECK (DiemCoBan >= 0 AND DiemThuongSom >= 0 AND NguongThuongSomGiay >= 0 AND DiemPhatTre >= 0)
  CONSTRAINT CK_ThuThachXuong_DonVi CHECK (DonViMucTieu IN (N'g', N'ml', N'atm'))
  CREATE UNIQUE INDEX UX_ThuThachXuong_Ngay_DoKho_Slot ON dbo.ThuThachXuong(NgayThuThach, DoKho, SlotThuThach) WHERE NgayThuThach IS NOT NULL AND SlotThuThach IS NOT NULL;
  '''
}

Table dbo.ThuThachXuongTaiNguyen {
  IDTaiNguyen int [pk, increment, not null]
  IDThuThach int [not null]
  IDHoaChat int [not null]
  Luong decimal(18,4) [not null]
  DonVi nvarchar(20) [not null]
  ThuTu int [not null]

  indexes {
    (IDThuThach, IDHoaChat) [unique, name: 'UX_ThuThachXuongTaiNguyen_ThuThach_HoaChat']
    (IDHoaChat) [name: 'IX_ThuThachXuongTaiNguyen_IDHoaChat']
  }

  Note: '''
  CONSTRAINT CK_ThuThachXuongTaiNguyen_Luong CHECK (Luong > 0)
  CONSTRAINT CK_ThuThachXuongTaiNguyen_DonVi CHECK (DonVi IN (N'g', N'ml', N'atm'))
  CONSTRAINT CK_ThuThachXuongTaiNguyen_ThuTu CHECK (ThuTu > 0)
  '''
}

Table dbo.PhienThuThachXuong {
  IDPhien int [pk, increment, not null]
  IDThuThach int [not null]
  IDUser int [not null]
  TrangThai nvarchar(30) [not null]
  BatDauLuc datetime2 [not null]
  HetHanLuc datetime2 [not null]
  HoanThanhLuc datetime2
  InventoryJson nvarchar(max) [not null]
  LuongMucTieuDatDuoc decimal(18,4)
  DatMucTieu bit [not null, default: 0]
  SoPhanUng int [not null, default: 0]
  SoLoi int [not null, default: 0]
  TrangThaiNghiVan nvarchar(30) [not null, default: 'Normal']
  LichSuSuKienJson nvarchar(max) [not null, default: '[]']
  DiemCoBan int [not null, default: 0]
  DiemThuong int [not null, default: 0]
  DiemPhat int [not null, default: 0]
  DiemCuoi int [not null, default: 0]
  ThoiLuongGiay int
  LyDoKetThuc nvarchar(200)

  indexes {
    (IDUser, IDThuThach, TrangThai) [name: 'IX_PhienThuThachXuong_User_Challenge_Status']
    (IDUser, IDThuThach) [unique, name: 'UX_PhienThuThachXuong_User_Challenge']
  }

  Note: '''
  CONSTRAINT CK_PhienThuThachXuong_TrangThai CHECK (TrangThai IN (N'Running', N'Completed', N'Failed', N'Expired', N'Dead'))
  CONSTRAINT CK_PhienThuThachXuong_NghiVan CHECK (TrangThaiNghiVan IN (N'Normal', N'Suspicious', N'Invalid'))
  CONSTRAINT CK_PhienThuThachXuong_Diem CHECK (DiemCoBan >= 0 AND DiemThuong >= 0 AND DiemPhat >= 0 AND DiemCuoi >= 0)
  CONSTRAINT CK_PhienThuThachXuong_Dem CHECK (SoPhanUng >= 0 AND SoLoi >= 0)
  CONSTRAINT CK_PhienThuThachXuong_ThoiLuong CHECK (ThoiLuongGiay IS NULL OR ThoiLuongGiay >= 0)
  CREATE INDEX IX_PhienThuThachXuong_Leaderboard ON dbo.PhienThuThachXuong(IDThuThach, TrangThai, DiemCuoi DESC, ThoiLuongGiay ASC, HoanThanhLuc ASC);
  '''
}

Table dbo.QuyLuatPhanUng {
