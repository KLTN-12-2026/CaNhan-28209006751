Table dbo.DeXuatTriThucAI {
  IDDeXuat int [pk, increment, not null]
  LoaiThucThe nvarchar(20) [not null]
  TrangThai nvarchar(30) [not null]
  KhoaUngVien nvarchar(200) [not null]
  TuKhoa nvarchar(200) [not null]
  NguonYeuCauJson nvarchar(max)
  PayloadJson nvarchar(max)
  PhienBanSchema int [not null, default: 1]
  KetQuaKiemTraJson nvarchar(max)
  Revision int [not null, default: 0]
  NguonGoc nvarchar(20) [not null]
  IDNguoiYeuCau int
  IDNguoiDuyet int
  LyDoQuyetDinh nvarchar(1000)
  IDBanGhiDich int
  NgayTao datetime2 [not null, default: `SYSUTCDATETIME()`]
  NgayCapNhat datetime2 [not null, default: `SYSUTCDATETIME()`]
  NgayQuyetDinh datetime2
  RowVer rowversion [not null]

  indexes {
    (TrangThai, NgayTao) [name: 'IX_DeXuatTriThucAI_TrangThai_NgayTao']
  }

  Note: '''
  CONSTRAINT CK_DeXuatTriThucAI_LoaiThucThe CHECK (LoaiThucThe IN (N'Chemical', N'Element', N'ReactionRule', N'Reaction'))
  CONSTRAINT CK_DeXuatTriThucAI_TrangThai CHECK (TrangThai IN (N'Collecting', N'InsufficientEvidence', N'ValidationFailed', N'Pending', N'Approved', N'Denied', N'ApplyFailed'))
  CONSTRAINT CK_DeXuatTriThucAI_NguonGoc CHECK (NguonGoc IN (N'Admin', N'Discovery'))
  CREATE UNIQUE INDEX UX_DeXuatTriThucAI_DangMo ON dbo.DeXuatTriThucAI(LoaiThucThe, KhoaUngVien) WHERE TrangThai IN (N'Collecting', N'InsufficientEvidence', N'ValidationFailed', N'Pending', N'ApplyFailed');
  '''
}

